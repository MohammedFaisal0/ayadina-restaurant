model Branch {
  id            Int      @id @default(autoincrement())
  nameAr        String   @map("name_ar") @db.VarChar(128)
  nameEn        String   @map("name_en") @db.VarChar(128)
  addressAr     String   @default("") @map("address_ar") @db.VarChar(512)
  addressEn     String   @default("") @map("address_en") @db.VarChar(512)
  phone         String   @default("") @db.VarChar(32)
  mapEmbedUrl   String   @default("") @map("map_embed_url") @db.VarChar(2048)
  directionsUrl String   @default("") @map("directions_url") @db.VarChar(2048)
  displayOrder  Int      @default(0) @map("display_order") @db.SmallInt()
  isMainBranch  Boolean  @default(false) @map("is_main_branch")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([displayOrder])
  @@index([isMainBranch])
  @@map("branches")
}

model GalleryImage {
  id           Int      @id @default(autoincrement())
  imageUrl     String   @map("image_url") @db.VarChar(2048)
  titleAr      String   @default("") @map("title_ar") @db.VarChar(255)
  titleEn      String   @default("") @map("title_en") @db.VarChar(255)
  displayOrder Int      @default(0) @map("display_order") @db.SmallInt()
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([displayOrder])
  @@map("gallery_images")
}

model ContactMessage {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(128)
  email     String   @db.VarChar(255)
  phone     String   @default("") @db.VarChar(32)
  subject   String   @default("") @db.VarChar(255)
  message   String   @db.Text()
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("contact_messages")
}
